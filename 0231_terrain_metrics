import ee

ee.Authenticate()
ee.Initialize(
    project = 'ee-amirhosseinahrari',
    opt_url = 'https://earthengine-highvolume.googleapis.com'
)

"""# **Study Area**"""

import geemap

map = geemap.Map(basemap = 'SATELLITE')
map

roi = map.draw_last_feature.geometry()
roi

"""# **DEM**"""

srtm = (
    ee.Image("USGS/SRTMGL1_003")
)

srtm

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

grid_100m = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (0.001, -0.001)
)

ds = xr.open_dataset(
    srtm,
    engine = 'ee',
    **grid_100m
)

ds = ds.squeeze('time').drop_vars('time') * 1

ds

"""# **Elevation**"""

ds.elevation.plot(
    x = 'x', y = 'y', robust =True, cmap = 'terrain'
)

"""# **Xarray Spatial**"""

!pip install xarray-spatial

from xrspatial import slope, aspect, tpi, tri, landforms

ds['slope'] = slope(ds.elevation)

ds.slope.plot(
    x = 'x', y = 'y', robust = True,
)

ds['aspect'] = aspect(ds.elevation)

ds['aspect'].plot(
    x = 'x', y = 'y', robust = True
)

ds['tpi'] = tpi(ds.elevation)

ds['tpi'].plot(
    x = 'x', y = 'y', robust = True
)

ds['tri'] = tri(ds.elevation)

ds['tri'].plot(
    x = 'x', y = 'y', robust =True
)

ds['landforms'] = landforms(ds.elevation)

ds['landforms'].plot(
    x = 'x', y = 'y', robust = True, cmap = 'turbo'
)

!pip install hvplot
import hvplot.xarray

ds['landforms'].hvplot(
    x = 'x', y = 'y', robust = True,
    cmap = 'turbo', height = 500
)
