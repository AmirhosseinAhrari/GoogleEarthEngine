import ee

ee.Authenticate()
ee.Initialize(
    project = 'ee-amirhosseinahrari',
    opt_url = 'https://earthengine-highvolume.googleapis.com'
)

"""# **Study Area**"""

import geemap

map = geemap.Map()
map

roi = map.draw_last_feature.geometry()
roi

"""# **Forest Loss Drivers**"""

img = (
    ee.Image("projects/landandcarbon/assets/wri_gdm_drivers_forest_loss_1km/v1_3_2001_2025")
    .select('classification')
)

img

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

grid_params = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (1,-1)
)

ds = xr.open_dataset(
    img,
    engine = 'ee',
    **grid_params
)

ds = ds.squeeze('time').drop_vars('time') * 1

"""# **Visualization**"""

import matplotlib.pyplot as plt
!pip install cartopy
import cartopy.crs as ccrs

ds

fig, ax = plt.subplots(figsize = (10, 5),
                       subplot_kw = {'projection': ccrs.Robinson()})

ds.classification.plot(
    ax = ax, x = 'x', y = 'y', robust = True,
    cmap = 'turbo', transform = ccrs.PlateCarree(),
    cbar_kwargs = {'orientation':'horizontal', 'shrink': 0.4,
                   'pad': 0.07}
)

ax.set_global()
ax.coastlines()
ax.gridlines(draw_labels = True, alpha =0.5, ls = ':')
ax.set_title('Global Forest Loss Drivers', fontsize = 15)

plt.savefig('forest_drivers.png', dpi = 360, bbox_inches = 'tight')
