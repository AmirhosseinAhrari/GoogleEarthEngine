import ee

ee.Authenticate()
ee.Initialize(
    project = 'ee-amirhosseinahrari',
    opt_url = 'https://earthengine-highvolume.googleapis.com'
)

"""# **Study Area**"""

import geemap

map = geemap.Map()
map

roi = map.draw_last_feature.geometry()
roi

"""# **Drought Image Collection**"""

terra = (
    ee.ImageCollection("IDAHO_EPSCOR/TERRACLIMATE")
    .filterDate('2010','2020')
    .select('pdsi', 'aet', 'pet', 'pr', 'ro', 'soil', 'tmmn', 'tmmx')
)

terra

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

grid_20km = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (0.2, -0.2)
)

ds = xr.open_dataset(
    terra,
    engine = 'ee',
    **grid_20km
)

ds = ds.sortby('time') * 1

ds['pdsi_class'] = ((ds['pdsi'] * 0.01) < -2.0).astype(int)

ds  = ds.drop_vars('pdsi')

ds

"""# **Sampling**"""

df = ds.to_dataframe().dropna()

x = df.drop('pdsi_class', axis = 1)
x

y = df['pdsi_class']
y

from sklearn.model_selection import train_test_split

x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size = 0.2, random_state = 42
)

"""# **Modelling**"""

from sklearn.ensemble import RandomForestClassifier

model = RandomForestClassifier(n_estimators = 100, random_state = 42)
model.fit(x_train, y_train)

y_pred = model.predict_proba(x_test)[:,1]

from sklearn.metrics import roc_auc_score

print(roc_auc_score(y_test, y_pred))

"""# **Risk Mapping**"""

df['drought_risk'] = model.predict_proba(x)[:,1]

risk_map = df['drought_risk'].to_xarray()

risk_map_mean = risk_map.mean(dim = 'time')

risk_map_mean.plot.contourf(
    x = 'x', y = 'y', robust = True, cmap = 'turbo', levels = 10
)

"""# **Export**"""

!pip install rioxarray
import rioxarray

out = risk_map_mean.copy()
out = out.rio.write_crs('EPSG:4326')
out = out.rio.set_spatial_dims(x_dim = 'x', y_dim = 'y')
out = out.rio.write_coordinate_system(inplace = True)
out

out.rio.to_raster('drought_risk.tiff')
