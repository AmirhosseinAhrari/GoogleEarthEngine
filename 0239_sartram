import ee

ee.Authenticate()
ee.Initialize(
    project = 'ee-amirhosseinahrari',
    opt_url = 'https://earthengine-highvolume.googleapis.com'
)

"""# **Study Area**"""

import geemap

map = geemap.Map(basemap = 'SATELLITE')
map

roi = map.draw_last_feature.geometry()
roi

"""# **SAR Image Collection**"""

sar = (
    ee.ImageCollection("OPERA/RTC/L2_V1/S1")
    .filterDate('2025','2026')
    .filterBounds(roi)
    .select('VV','VH')
    .filter(ee.Filter.eq('ORBIT_PASS_DIRECTION', 'descending'))
)

sar

dw = (
    ee.ImageCollection("GOOGLE/DYNAMICWORLD/V1")
    .filterDate('2025','2026')
    .filterBounds(roi)
    .select('label')
    .mode().eq(6).Not()
)

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

sar.first().select('VV').projection()

grid = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:32638',
    grid_scale = (30, -30)
)

ds = xr.open_dataset(
    sar,
    engine = 'ee',
    **grid,
    chunks = 'auto'
)

from dask.diagnostics import ProgressBar

with ProgressBar():
  ds = ds.compute()

ds

mask = xr.open_dataset(
    dw,
    engine = 'ee',
    **grid
)

mask = mask.squeeze('time').drop_vars('time') * 1

mask

"""# **Temporal Aggregation**"""

ds = ds.sortby('time')

ds_monthly = ds.resample(time = 'M').mean('time')

ds_smooth = ds_monthly.rolling(time = 3, center = True, min_periods = 1).mean('time')

ds_mean = ds_smooth.mean(dim = 'time')

ds_mask = ds_mean.where(mask.label)

rvi = (4 * ds_mask.VH) / (ds_mask.VH + ds_mask.VV)

import matplotlib.pyplot as plt

fig, ax = plt.subplots(1, 3, figsize = (15, 4))

ds_mask.VV.plot(ax = ax[0], robust = True)
ds_mask.VH.plot(ax = ax[1], robust = True)
rvi.plot(ax = ax[2], robust = True)

plt.tight_layout()

"""# **Soil Moisture**"""

import numpy as np

x = rvi.values.flatten()
x = x[~np.isnan(x)]
x = x.reshape(-1, 1)
x

y = ds_mask.VH.values.flatten()
y = y[~np.isnan(y)]
y

samples = np.random.choice(len(x), 10000, replace = False)
samples

x_samples = x[samples]
y_samples = y[samples]

from sklearn.linear_model import QuantileRegressor

dry_model = QuantileRegressor(
    quantile = 0.05,
    alpha = 0
).fit(x_samples, y_samples)

dry_edge = (
    dry_model.intercept_ +
    dry_model.coef_[0] * rvi
)

wet_model = QuantileRegressor(
    quantile = 0.95,
    alpha = 0
).fit(x_samples, y_samples)

wet_edge = (
    wet_model.intercept_ +
    wet_model.coef_[0] * rvi
)

sm = (ds_mask.VH - dry_edge) / (wet_edge - dry_edge)
sm = sm.clip(0,1)

sm.plot(robust = True)
