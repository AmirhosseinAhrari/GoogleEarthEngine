import ee

ee.Authenticate()
ee.Initialize(
    project = 'ee-amirhosseinahrari',
    opt_url = 'https://earthengine-highvolume.googleapis.com'
)

"""# **Study Area**"""

import geemap

map = geemap.Map(basemap = 'SATELLITE')
map

roi = map.draw_last_feature.geometry()
roi

"""# **Image Collection**"""

era5 = (
    ee.ImageCollection("ECMWF/ERA5_LAND/MONTHLY_AGGR")
    .filterDate('2015', '2026')
    .select('temperature_2m')
)

era5

time_start = ee.Date('2015')
time_end = ee.Date('2026')
time_dif = time_end.difference(time_start, 'month')
time_list = ee.List.sequence(0, ee.Number(time_dif).subtract(1)).map(
    lambda x: time_start.advance(x, 'month')
)

time_list

def monthly(date_list, col):
  start_month = ee.Date(date_list)
  end_month = start_month.advance(1, 'month')
  col_month = col.filterDate(start_month, end_month).mean()
  return col_month.set('system:time_start', start_month.millis())

ndvi = (
    ee.ImageCollection("MODIS/061/MOD13A2")
    .filterDate(time_start, time_end)
    .select('EVI','NDVI')
)

lst = (
    ee.ImageCollection("MODIS/061/MOD11A2")
    .filterDate(time_start, time_end)
    .select('LST_Day_1km','LST_Night_1km')
)

et  = (
    ee.ImageCollection("MODIS/061/MOD16A2GF")
    .filterDate(time_start, time_end)
    .select('ET','PET')
)

lc = (
    ee.ImageCollection("MODIS/061/MCD12Q1")
    .filterDate(time_start, time_end)
    .select('LC_Type1')
    .mode()
)

topo = (
    ee.Image("USGS/GTOPO30")
)

ndvi_monthly = ee.ImageCollection(
    time_list.map(lambda x: monthly(x, ndvi))
)

ndvi_monthly

lst_monthly = ee.ImageCollection(
    time_list.map(lambda x: monthly(x, lst))
)

lst_monthly

et_monthly = ee.ImageCollection(
    time_list.map(lambda x: monthly(x, et))
)

et_monthly

collection = ndvi_monthly.combine(lst_monthly).combine(et_monthly).map(
    lambda img: img.addBands(lc).addBands(topo)
)
collection

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

grid_10km = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (0.1, -0.1)
)

pred_10km = xr.open_dataset(
    collection,
    engine = 'ee',
    **grid_10km
)

pred_10km = pred_10km.sortby('time') * 1

temp_10km = xr.open_dataset(
    era5,
    engine = 'ee',
    **grid_10km
)

temp_10km = temp_10km.sortby('time') - 273.15

ds_10km = xr.merge([pred_10km, temp_10km])

ds_10km

"""# **Sampling**"""

df_10km = ds_10km.to_dataframe()

df_10km

x = df_10km.drop('temperature_2m', axis = 1)
x

y = df_10km['temperature_2m']
y

from sklearn.model_selection import train_test_split

x_train, x_test, y_train, y_test = train_test_split(
    x, y, test_size = 0.2, random_state = 42
)

from sklearn.ensemble import RandomForestRegressor

model = RandomForestRegressor(n_estimators = 100, random_state = 42)
model.fit(x_train, y_train)

y_pred = model.predict(x_test)

from sklearn.metrics import mean_squared_error, r2_score

import numpy as np

rmse = np.sqrt(mean_squared_error(y_test, y_pred))
rmse

r2 = r2_score(y_test, y_pred)
r2

"""# **Downscaling**"""

grid_1km = helpers.fit_geometry(
    geometry = shape(roi.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (0.01, -0.01)
)

ds_1km = xr.open_dataset(
    collection,
    engine = 'ee',
    **grid_1km
)

ds_1km = ds_1km.sortby('time') * 1

df_1km = ds_1km.to_dataframe()

df_1km['temp_pre'] = model.predict(df_1km)

dx = df_1km.to_xarray()

"""# **Visualization**"""

import matplotlib.pyplot as plt

fig, ax = plt.subplots(1, 2, figsize = (10, 4))

ds_10km.temperature_2m.isel(time = 103).plot(ax = ax[0], x = 'x', y = 'y', robust = True, cmap = 'turbo')
dx.temp_pre.isel(time = 103).plot(ax = ax[1], x = 'x', y = 'y', robust = True, cmap = 'turbo')

plt.tight_layout()
