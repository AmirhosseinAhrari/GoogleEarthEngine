)

"""# **Study Area**"""

import geemap

map = geemap.Map(basemap = 'SATELLITE')
map

roi = ee.FeatureCollection(map.draw_features)

roi

canada = (
    ee.FeatureCollection("USDOS/LSIB_SIMPLE/2017")
    .filterBounds(roi)
    .geometry().simplify(1000)
)

map.addLayer(canada, {},'canada')

"""# **ERA5 Image Collection**"""

era5 = (
    ee.ImageCollection("ECMWF/ERA5/DAILY")
    .filterDate('2010','2020')
    .select(['maximum_2m_air_temperature','total_precipitation'],
            ['max_temp', 'pr'])
)

era5

"""# **to Xarray**"""

from xee import helpers
from shapely.geometry import shape
import xarray as xr

grid_30km = helpers.fit_geometry(
    geometry = shape(canada.getInfo()),
    grid_crs = 'EPSG:4326',
    grid_scale = (0.3, -0.3)
)

ds = xr.open_dataset(
    era5,
    engine = 'ee',
    **grid_30km
)

ds = ds.sortby('time') * 1

"""# **Data Preparation**"""

ds['pr'] = ds['pr'] * 1000
ds['pr'].attrs['units'] = 'mm/day'

ds_annual = ds['pr'].resample(time = 'YE').sum('time')
ds_annual = ds_annual.mean(dim = 'time')
ds_annual.attrs['units'] = 'mm/year'
ds_annual

ds['max_temp'] = ds['max_temp'] - 273.15
ds['max_temp'].attrs['units'] = 'degC'
ds

!pip install rioxarray
import rioxarray

import geopandas as gpd

canada_gdf = geemap.ee_to_gdf(ee.FeatureCollection(canada))

ds_clip = ds.rio.clip(canada_gdf.geometry, canada_gdf.crs)

pr_annual_clip = ds_annual.rio.clip(canada_gdf.geometry, canada_gdf.crs)

"""# **KBDI**"""

!pip install xclim

import xclim.indicators.atmos as xindex

help(xindex.keetch_byram_drought_index)

kbdi = xindex.keetch_byram_drought_index(
    pr = ds_clip['pr'],
    tasmax = ds_clip['max_temp'],
    pr_annual = pr_annual_clip
)

kbdi_mean = kbdi.max(dim = 'time')

kbdi_mean.plot.contourf(
    x = 'x', y = 'y', robust = True,
    figsize = (12, 5), cmap = 'turbo',
    levels = 10
)

kbdi.sel(x = -120.776171875,
         y = 51.63486105108019,
         method = 'nearest').to_dataframe()['kbdi'].plot()
